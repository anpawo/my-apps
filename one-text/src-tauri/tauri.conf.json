{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "one-text",
  "version": "0.1.0",
  "identifier": "com.mr.one-text",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "one-text",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "x": 0,
        "y": 0,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
