Screen { background: #faf9f6; color: #27312e; }
#topbar { dock: top; height: 3; padding: 1 2; background: #e9eee7; color: #416d5c; text-style: bold; }
#transcript { height: 1fr; padding: 1 3; scrollbar-color: #c0c9bf; scrollbar-background: #faf9f6; }
#welcome { color: #778078; margin: 2 0; height: auto; }
.user-message { background: #ffe8b3; color: #493d24; padding: 1 2; margin: 1 0; height: auto; }
.reply { color: #27312e; padding: 1 0; height: auto; }
.tools { background: #f1f0eb; color: #6d776f; border: none; padding: 0; margin: 0 0 1 0; }
.tools > CollapsibleTitle { background: #f1f0eb; color: #6d776f; padding: 0 1; }
.tools > Contents { padding: 0 1; }
.tool { height: auto; padding: 1; border-left: solid #c5cec2; margin: 0 0 1 0; }
.notice { color: #68746b; height: auto; padding: 1 0; }
.error { background: #fbe8e2; color: #a12b2b; height: auto; padding: 1 2; margin: 1 0; }
#composer { dock: bottom; height: auto; }
#activity { height: 1; margin: 0 3; color: #657466; }
#draft { height: auto; margin: 0 2; border: round #b5c6b7; background: #ffffff; }
#draft:focus-within { border: round #648b73; }
#attachments { display: none; height: auto; padding: 0 1; overflow-x: auto; }
.image-chip { width: auto; min-width: 0; height: 1; margin: 0 1 0 0; padding: 0 1; border: none; background: #e9eee7; color: #416d5c; }
#prompt { height: 3; width: 1fr; border: none; background: #ffffff; color: #27312e; }
#keys { height: auto; padding: 0 3; color: #7c847d; background: #faf9f6; }
RequestScreen { align: center middle; background: #27312e 45%; }
#request-box { width: 90%; max-width: 100; height: 80%; max-height: 35; background: #faf9f6; border: round #648b73; padding: 1 2; }
#request-details { height: 1fr; }
.request-title { text-style: bold; margin: 1 0; height: auto; }
.request-buttons { height: 3; margin-top: 1; }
.request-buttons Button { width: 1fr; min-width: 0; margin-right: 1; }
